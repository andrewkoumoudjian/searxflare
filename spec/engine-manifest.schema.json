{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searxflare.dev/schemas/engine-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "endpoint", "method", "categories", "source_kind", "allowed_hosts", "capabilities", "limits", "versions", "cache", "state", "default_enabled"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https://" },
    "method": { "enum": ["GET", "POST"] },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "source_kind": { "enum": ["atom", "json", "html"] },
    "allowed_hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" } },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paging", "locale", "country", "safe_search", "time_range"],
      "properties": {
        "paging": { "type": "boolean" },
        "locale": { "type": "boolean" },
        "country": { "type": "boolean" },
        "safe_search": { "type": "boolean" },
        "time_range": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_body_bytes", "max_steps", "max_redirects"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 8000 },
        "max_body_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 3 },
        "max_redirects": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser"],
      "properties": { "parser": { "type": "string", "minLength": 1 } }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_ttl_seconds", "negative_ttl_seconds"],
      "properties": {
        "response_ttl_seconds": { "type": "integer", "minimum": 1 },
        "negative_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "state": { "enum": ["stateless", "kv_snapshot", "durable_coordinator"] },
    "default_enabled": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
