{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searxflare.dev/schemas/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["url", "canonical_url", "title", "content", "category", "metadata", "engines", "positions", "score"],
  "properties": {
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "canonical_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "title": { "type": "string" },
    "content": { "type": "string" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "thumbnail": { "type": ["string", "null"], "format": "uri" },
    "category": { "type": "string" },
    "metadata": { "type": "object" },
    "engines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "positions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "score": { "type": "number" }
  }
}
